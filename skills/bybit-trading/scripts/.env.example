# Bybit Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# Bybit API Credentials (Required)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Trading Configuration
TRADING_SYMBOL=BTC/USDT:USDT
LEVERAGE=5

# Position Sizing (percentage of available balance)
POSITION_SIZE_PCT=5

# Take Profit / Stop Loss defaults
TP_PCT=0.8
SL_PCT=0.5

# Scalping Bot Settings
RSI_PERIOD=14
BB_PERIOD=20
BB_STD=2.0
MAX_HOLD_MINUTES=20

# Mean Reversion Settings
TIMEFRAME=5m
DEVIATION_THRESHOLD=2.0
LOOKBACK_PERIOD=50

# Momentum Settings
VOLUME_MULTIPLIER=1.5

# Grid Trading Settings
GRID_LEVELS=10
GRID_SPACING=1.0
GRID_POSITION_SIZE=100

# Risk Management
MAX_DAILY_LOSS_PCT=5
MAX_DRAWDOWN_PCT=10
CIRCUIT_COOLDOWN_HOURS=4

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Output
OUTPUT_JSON=/tmp/bybit_bots/pnl_report.json
